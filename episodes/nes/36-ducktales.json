 "lines": [
  {
   "say": "Capcom's best-selling NES game isn't Mega Man. It's DuckTales.",
   "scene": {
    "kind": "title"
   }
  },
  {
   "say": "DuckTales came out in America in October 1989, based on the Disney cartoon.",
   "scene": {
    "bg": "space",
    "head": "1989",
    "headsc": 4,
    "prop": "port",
    "args": {
     "label": "DUCK TALES",
     "col": "blu"
    },
    "subs": [
     "CAPCOM + DISNEY"
    ]
   }
  },
  {
   "say": "It was built by staff from the Mega Man team, including Keiji Inafune.",
   "scene": {
    "bg": "lab",
    "head": "THE MEGA MAN TEAM",
    "headsc": 2,
    "prop": "team",
    "args": {
     "n": 3
    }
   }
  },
  {
   "say": "You play as Scrooge McDuck, and your cane is everything. Jump on it, and it works like a pogo stick.",
   "scene": {
    "bg": "grass",
    "head": "THE POGO CANE",
    "headsc": 2,
    "prop": "pogo"
   }
  },
  {
   "say": "Bounce on enemies, bounce over spikes, and bounce your way to treasure.",
   "scene": {
    "bg": "jungle",
    "head": "BOUNCE!",
    "headcol": "lgrn",
    "prop": "pogo"
   }
  },
  {
   "say": "There are five levels, and you can play them in any order.",
   "scene": {
    "bg": "dark",
    "head": "5 LEVELS",
    "prop": "list",
    "args": {
     "items": [
      "AFRICAN MINES",
      "THE AMAZON",
      "THE HIMALAYAS",
      "TRANSYLVANIA",
      "THE MOON"
     ]
    }
   }
  },
  {
   "say": "The Moon level's music, by Hiroshige Tonomura, became one of the most loved songs in 8-bit history.",
   "scene": {
    "bg": "moon",
    "head": "THE MOON THEME",
    "headsc": 2,
    "prop": "notes",
    "subs": [
     "BY HIROSHIGE TONOMURA"
    ]
   }
  },
  {
   "say": "The game has three endings, based on how much money you finish with. Ten million dollars or more gets you the best one.",
   "scene": {
    "bg": "dark",
    "head": "3 ENDINGS",
    "prop": "gems",
    "args": {
     "n": 10000000
    },
    "subs": [
